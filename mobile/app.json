{
  "expo": {
    "name": "BarberPro",
    "slug": "barberpro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1c1917",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barberpro.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1c1917"
      },
      "package": "com.barberpro.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BarberPro to access your photos to upload shop logos, QR codes, and profile avatars."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "49b9ba4a-1ae1-4e36-b8cf-7dc7bcab97f3"
      }
    },
    "owner": "aniketkorde13"
  }
}
